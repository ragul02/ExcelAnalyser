{
  "name": "data-analyser",
  "version": "1.2.0",
  "description": "Excel data visualization and analysis application",
  "author": "Southernstore apps",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:prod": "ng build --configuration production",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "ng build && electron .",
    "electron:start": "npm run build:prod && electron .",
    "electron:dev": "concurrently \"npm start -- --host 127.0.0.1 --port 4200\" \"wait-on http://127.0.0.1:4200 && electron . --dev\"",
    "electron:build": "npm run build:prod && electron-builder",
    "electron:build:win": "npm run build:prod && electron-builder --win",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "npm run version:patch && npm run electron:build:win"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "buffer": "^6.0.3",
    "comlink": "^4.4.2",
    "onnxruntime-web": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "Southernstoreapps.DataAnalyzer",
    "productName": "Data Analyzer",
    "directories": {
      "output": "dist-electron",
      "buildResources": "src/assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/DataAnalyzer/**/*",
      "preload.js",
      "package.json",
      "!node_modules/**/*",
      "!**/*.ts",
      "!*.log",
      "!.git",
      "!.vscode",
      "!.angular",
      "!src",
      "!*.md"
    ],
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "identityName": "Southernstoreapps.DataAnalyzer",
      "publisher": "CN=D2607C64-7CC3-46F2-9164-7FEBC6EAA60B",
      "displayName": "Data Analyzer",
      "publisherDisplayName": "Southernstore apps",
      "backgroundColor": "#464646",
      "languages": [
        "en-US"
      ],
      "applicationId": "DataAnalyzer",
      "addAutoLaunchExtension": false,
      "showNameOnTiles": true,
      "setBuildNumber": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon/icon.png",
      "category": "Utility"
    }
  }
}
